{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.staging)",
      "Read(./.env.production)",
      "Read(./.env.*.local)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.staging)",
      "Edit(./.env.production)",
      "Edit(./.env.*.local)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git checkout -- :*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout main:*)",
      "Bash(git switch main:*)",
      "Bash(docker compose exec app php artisan migrate:*)",
      "Bash(docker compose exec app php artisan db:*)",
      "Bash(docker compose exec app php artisan tinker:*)",
      "Bash(docker compose exec app composer require:*)",
      "Bash(docker compose exec app composer remove:*)",
      "Bash(docker compose exec app composer update:*)",
      "Bash(docker compose exec app npm install:*)",
      "Bash(docker compose exec app npm uninstall:*)",
      "Bash(docker compose exec app npm update:*)",
      "Bash(docker compose exec app npx shadcn:*)",
      "Bash(docker compose down:*)",
      "Bash(docker volume:*)",
      "Bash(docker system prune:*)",
      "Bash(docker image prune:*)",
      "Bash(php artisan migrate:*)",
      "Bash(php artisan db:*)",
      "Bash(composer require:*)",
      "Bash(composer remove:*)",
      "Bash(composer update:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm update:*)",
      "Bash(npx shadcn:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "docker compose exec -T app php vendor/bin/pint --dirty --quiet"
          }
        ]
      }
    ]
  }
}

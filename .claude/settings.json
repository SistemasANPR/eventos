{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "docker compose exec -T app php vendor/bin/pint --dirty --quiet"
          }
        ]
      }
    ]
  }
}

APP_NAME=Eventos
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

# Proxies de confianza (IPs o CIDR separados por comas). Vacío = no se confía en ninguno.
# Detrás de un balanceador, fijar su rango real; `*` solo con intención explícita (docs/operacion.md).
TRUSTED_PROXIES=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=eventos
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Disco PRIVADO de archivos de usuarios (plan 007). En staging/produccion, un bucket S3 privado.
PRIVATE_UPLOADS_DISK=local
# Disco de las imagenes del programa (plan 021): nombre de un disco de config/filesystems.php. Hoy "media" (local, privado).
MEDIA_DISK=media
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="eventos@example.test"
MAIL_FROM_NAME="${APP_NAME}"
# Proveedor del correo transaccional (ADR-0009): smtp en local (Mailpit), resend en staging y produccion.
NOTIFICATIONS_MAILER=smtp
RESEND_API_KEY=

# Anti-robots de los formularios publicos (plan 006). Llaves de prueba de Cloudflare: siempre aprueban.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Multiplica los límites de intentos de los formularios públicos (plan 006). 1 en producción; en staging se puede subir (por ejemplo 100).
SUBMISSIONS_LIMIT_MULTIPLIER=1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Docker (Sail). Valores de esta máquina: ver docs/entorno-local.md.
APP_SERVICE=app
APP_PORT=8080
VITE_PORT=5173
FORWARD_DB_PORT=5433
FORWARD_REDIS_PORT=6379
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025
WWWUSER=1000
WWWGROUP=1000

# Panel de plataforma (plan 016): por defecto solo en local y pruebas; en producción y staging queda apagado
# hasta que exista la 2FA (plan 014). Descomentar con true para habilitarlo.
# PLATFORM_PANEL_ENABLED=false
